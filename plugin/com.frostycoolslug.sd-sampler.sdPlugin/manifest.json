{
  "Name": "SD Sampler",
  "Version": "0.0.0.0",
  "Author": "sd-sampler",
  "Description": "A Sampler plugin inspired by the GoXLR",
  "Icon": "icons/plugin",

  "Category": "Sampler",
  "CategoryIcon": "icons/plugin",

  "CodePath": "sd-sampler",
  "CodePathLin": "sd-sampler",
  "CodePathWin": "sd-sampler.exe",
  "CodePathMac": "sd-sampler-mac",
  "SDKVersion": 2,

  "OS": [
    { "Platform": "linux", "MinimumVersion": "5.0" },
    { "Platform": "windows", "MinimumVersion": "10" },
    { "Platform": "mac", "MinimumVersion": "10.15" }
  ],

  "Actions": [
    {
      "Name": "Sample Pad",
      "UUID": "com.frostycoolslug.sd-sampler.pad",
      "Icon": "icons/pad",
      "Tooltip": "Button for playing and recording samples",
      "Controllers": ["Keypad"],
      "PropertyInspectorPath": "property_inspector/plugin.html",
      "States": [
        { "Image": "icons/pad", "ShowTitle": false }
      ]
    },
    {
      "Name": "Clear Sample Pad",
      "UUID": "com.frostycoolslug.sd-sampler.clear",
      "Icon": "icons/clear",
      "Tooltip": "Button for clearing all samples on a Pad",
      "Controllers": ["Keypad"],
      "States": [
        { "Image": "icons/clear", "ShowTitle": false }
      ]
    },
    {
      "Name": "Add to Sample Pad",
      "UUID": "com.frostycoolslug.sd-sampler.add",
      "Icon": "icons/add",
      "Tooltip": "Button for adding a new sample to the end of a Pad's stack",
      "Controllers": ["Keypad"],
      "States": [
        { "Image": "icons/add", "ShowTitle": false }
      ]
    }
  ]
}